# ── Datasets & large raw data ──────────────────────────────────────────────────
datasets/
data/
outputs/

# Model weights & large scratch files
*.h5
*.bin
*.safetensors
*.zip
*.tar.gz
*.onnx

# Explicitly preserve retrained model weights
!outputs/retrained/
!outputs/retrained/**

# ── Python caches & virtual environments ───────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage/
htmlcov/

# ── Git & logs ─────────────────────────────────────────────────────────────────
.git/
.gitignore
logs/
*.log
