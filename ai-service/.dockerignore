# ── Datasets & large raw data ──────────────────────────────────────────────────
datasets/
data/
outputs/
report_generation/vlm_weights/
test_nih/images/
test_nih/*.csv

# Model weights & large scratch files
*.h5
*.bin
*.safetensors
*.zip
*.tar.gz
*.onnx
*.pth
*.pt
*.ckpt

# Explicitly preserve NIH production checkpoint
!test_nih/saved_models/
!test_nih/saved_models/*

# ── Python caches & virtual environments ───────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage/
htmlcov/

# ── Git & logs ─────────────────────────────────────────────────────────────────
.git/
.gitignore
logs/
*.log
