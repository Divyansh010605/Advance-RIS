# ── Datasets & large raw data ──────────────────────────────────────────────────
datasets/
data/
ai-service/datasets/
ai-service/data/
ai-service/outputs/

# Model weights & archives
*.h5
*.bin
*.safetensors
*.zip
*.tar.gz
*.onnx

# Explicitly preserve retrained model weights in ai-service
!ai-service/outputs/retrained/
!ai-service/outputs/retrained/**

# ── Caches & Virtual Environments ──────────────────────────────────────────────
node_modules/
frontend/node_modules/
Backend/node_modules/
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage/
htmlcov/

# ── Git & logs ─────────────────────────────────────────────────────────────────
.git/
.gitignore
logs/
*.log
Backend/logs/
Backend/uploads/

# ── Build outputs ──────────────────────────────────────────────────────────────
build/
dist/
frontend/build/
