# ===============================================================================
# NIH ChestX-ray14 Multi-Disease AI Service & RIS — Comprehensive .gitignore
# Prevents exposure of secrets, PHI, model weights, datasets, build artifacts, and caches
# ===============================================================================

# ── 1. Security, Secrets & Environment Variables ──────────────────────────────
.env
.env.*
*.env
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets/
credentials.json
token.json
*.token

# ── 2. Medical Data & Protected Health Information (PHI) ─────────────────────
# Raw DICOM images and clinical study uploads must never be committed
*.dcm
*.dicom
uploads/
Backend/uploads/
ai-service/uploads/
frontend/uploads/

# ── 3. Datasets, Model Caches & Raw Archives ──────────────────────────────────
# NIH ChestX-ray14 and large raw archive downloads
datasets/
ai-service/datasets/
images_*/
archive/
*.tar.gz
*.zip
*.7z
*.rar

# Model download & runtime cache directories
xrv-cache/
hf-cache/
.cache/
ai-service/.cache/
ai-service/hf-cache/
ai-service/xrv-cache/

# Benchmark and testing data (explicitly retained per project structure)
!ai-service/data/
!ai-service/data/**

# ── 4. Machine Learning Artifacts & Checkpoints ───────────────────────────────
# Checkpoints & weights (exceed GitHub 100MB limit; keep locally on disk)
*.pt
*.pth
*.ckpt
*.h5
*.bin
*.safetensors
*.pb
*.tflite
*.onnx

# Ignore retrained weights directory to prevent committing heavy models (>100MB)
ai-service/outputs/retrained/
ai-service/outputs/retrained/**
!ai-service/outputs/retrained/.gitkeep
!ai-service/outputs/retrained/*/.gitkeep

# Explicitly keep lightweight benchmark evaluation metrics and outputs
!ai-service/outputs/vlm_eval/
!ai-service/outputs/vlm_eval/**

# Ignore temporary training checkpoints, runs, and artifacts
ai-service/outputs/checkpoints/
ai-service/outputs/runs/
ai-service/outputs/wandb/
wandb/

# Incomplete / temporary downloads
*.part
*.crdownload
*.incomplete

# ── 5. Node.js & Frontend Artifacts ───────────────────────────────────────────
node_modules/
Backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build/
dist/
out/
.next/
frontend/build/

# ── 6. Python Virtual Environments, Bytecode & Testing ─────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
ai-service/.pytest_cache/
.coverage
coverage/
htmlcov/
.hypothesis/
.ipynb_checkpoints/
*.tmp
*.temp

# ── 7. Databases & Container Volumes ──────────────────────────────────────────
data/db/
mongo-data/
*.sqlite
*.sqlite3
*.db

# ── 8. Logs & Telemetry ───────────────────────────────────────────────────────
logs/
Backend/logs/
ai-service/logs/
*.log

# ── 9. IDE, OS & Agent System Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.system_generated/
.antigravity/
brain/

*.png