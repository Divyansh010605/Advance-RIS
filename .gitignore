# ===============================================================================
# NIH ChestX-ray14 Multi-Disease AI Service & RIS — Comprehensive .gitignore
# Prevents exposure of secrets, PHI, model weights, datasets, build artifacts, and caches
# ===============================================================================

# ── 1. Security, Secrets & Environment Variables ──────────────────────────────
.env
.env.*
*.env
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets/
credentials.json
token.json
*.token

# ── 2. Medical Data & Protected Health Information (PHI) ─────────────────────
# Raw DICOM images and clinical study uploads must never be committed
*.dcm
*.dicom
uploads/
Backend/uploads/
ai-service/uploads/
frontend/uploads/

# ── 3. Datasets & Raw Image Archives ──────────────────────────────────────────
# NIH ChestX-ray14 and related clinical datasets
datasets/
data/
ai-service/datasets/
ai-service/data/
images/
images_*/
archive/
*.tar.gz
*.zip
*.7z
*.rar

# NIH metadata CSVs and test datasets
Data_Entry_*.csv
BBox_List_*.csv
ai-service/test_nih/Data_Entry_*.csv
ai-service/test_nih/BBox_List_*.csv
ai-service/test_nih/images/
test_nih/images/

# ── 4. Heavy Machine Learning Artifacts & Model Checkpoints ───────────────────
# Checkpoints & ONNX exports (exceed standard git limits; manage via Git LFS if needed)
*.pth
*.pt
*.ckpt
*.h5
*.bin
*.safetensors
*.pb
*.tflite
*.onnx

# Training runs, retrained weights, and evaluation outputs
outputs/
ai-service/outputs/
report_generation/vlm_weights/
ai-service/report_generation/vlm_weights/
test_nih/saved_models/
ai-service/test_nih/saved_models/

# Incomplete / temporary downloads
*.part
*.crdownload
*.incomplete

# ── 5. Node.js & Frontend Artifacts ───────────────────────────────────────────
node_modules/
Backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build/
dist/
out/
.next/
frontend/build/

# ── 6. Python Virtual Environments, Bytecode & Caches ─────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
ai-service/.pytest_cache/
.coverage
coverage/
htmlcov/
.hypothesis/
.ipynb_checkpoints/
*.tmp
*.temp

# ── 7. Databases & Container Volumes ──────────────────────────────────────────
data/db/
mongo-data/
*.sqlite
*.sqlite3
*.db

# ── 8. Logs & Telemetry ───────────────────────────────────────────────────────
logs/
Backend/logs/
ai-service/logs/
*.log

# ── 9. IDE, OS & Agent System Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.system_generated/
.antigravity/
brain/
