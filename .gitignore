# ===============================================================================
# NIH ChestX-ray14 Multi-Disease AI Service — Public Repository .gitignore
# Prevents exposure of secrets, medical data (PHI), large models, and build artifacts
# ===============================================================================

# ── 1. Security, Secrets & Environment Variables ──────────────────────────────
.env
.env.*
*.env
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets/
credentials.json
token.json
*.token

# ── 2. Medical Data & Protected Health Information (PHI) ─────────────────────
# Raw DICOM images and clinical study uploads must never be committed publicly
*.dcm
*.dicom
uploads/
Backend/uploads/
ai-service/uploads/

# ── 3. Datasets & Raw Image Archives ──────────────────────────────────────────
# Download datasets separately using DATASET_SETUP.md
datasets/
data/
ai-service/datasets/
ai-service/data/
images/
images_*/
archive/
*.tar.gz
*.zip
*.7z
*.rar

# Large NIH metadata CSVs (re-download from NIH ChestX-ray14 repository)
Data_Entry_*.csv
BBox_List_*.csv
ai-service/test_nih/Data_Entry_2017_v2020.csv

# ── 4. Heavy Machine Learning Artifacts & Model Checkpoints ───────────────────
# Checkpoints & ONNX exports (GitHub rejects single files >100MB)
*.pth
*.pt
*.ckpt
*.h5
*.bin
*.safetensors
*.pb
*.tflite
*.onnx
ai-service/test.onnx
ai-service/test2.onnx

# Training runs, retrained weights, and evaluation outputs
outputs/
ai-service/outputs/
report_generation/vlm_weights/
ai-service/report_generation/vlm_weights/

# If keeping the base pre-trained DenseNet checkpoint in git via LFS or direct commit,
# uncomment the two lines below:
# !ai-service/test_nih/saved_models/
# !ai-service/test_nih/saved_models/nih_densenet121.pth

# ── 5. Node.js & Frontend Artifacts ───────────────────────────────────────────
node_modules/
Backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build/
dist/
out/
.next/
frontend/build/

# ── 6. Python Virtual Environments, Bytecode & Caches ─────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage/
htmlcov/
.hypothesis/
.ipynb_checkpoints/
*.crdownload
*.tmp

# ── 7. Databases & Container Volumes ──────────────────────────────────────────
data/db/
mongo-data/
*.sqlite
*.sqlite3
*.db

# ── 8. Logs & Telemetry ───────────────────────────────────────────────────────
logs/
Backend/logs/
ai-service/logs/
*.log

# ── 9. IDE, OS & Agent System Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.system_generated/
.antigravity/
